# SignalForge — example environment. Copy to .env for local use. Never commit .env.
# NOTE: config/default.toml holds non-secret settings only. Secrets live HERE (env vars), never in TOML or git.

# API authentication
# Set to "1" to require Bearer token auth on protected endpoints (fail-closed).
# When "1", SIGNALFORGE_API_TOKEN must also be set or the app refuses to start.
SIGNALFORGE_AUTH_REQUIRED=1

# Bearer token for protected API endpoints (only used when SIGNALFORGE_AUTH_REQUIRED=1).
# Generate with: openssl rand -hex 32
# Provide at runtime only; never commit this file.
SIGNALFORGE_API_TOKEN=

# Exchange API keys (NOT needed for Phase 1 public read-only data; leave empty)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Optional future AI provider keys (Phase 4+, all optional, never required)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# NOTE: Ollama (local) needs no API key.

# Logging override (optional, defaults to INFO from config/default.toml)
# SF_LOG_LEVEL=INFO
