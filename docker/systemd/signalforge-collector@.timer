[Unit]
Description=SignalForge Q5.2 Prospective Collection Epoch 3 (%i timer)
Documentation=https://github.com/dmdipanshu/DM-Crypto-Quant-Signal
After=docker.service network-online.target
Wants=network-online.target

[Timer]
# Run once per hour at the specified minute (UTC)
OnCalendar=*-%m-%d %H:%i:00 UTC
Persistent=false
# No catch-up: if a scheduled run is missed, do not run it later
AccuracySec=1min
Unit=signalforge-collector.service

[Install]
WantedBy=timers.target
