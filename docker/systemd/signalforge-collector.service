[Unit]
Description=SignalForge Q5.2 Prospective Collection Epoch 3 (oneshot)
Documentation=https://github.com/dmdipanshu/DM-Crypto-Quant-Signal
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/DM-Crypto-Quant-Signal
ExecStart=/usr/bin/docker compose -f /home/ubuntu/DM-Crypto-Quant-Signal/compose.yaml --profile q5-collector run --rm collector
User=ubuntu
Group=docker
TimeoutStartSec=900
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
# Do not use ProtectHome=true: project lives under /home/ubuntu.
# Do not use ProtectSystem=strict: Docker socket and compose paths need access.

[Install]
WantedBy=multi-user.target
